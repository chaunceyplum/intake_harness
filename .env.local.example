# Paste the McpEndpointUrl SAM output from the chaunceyplum/mcp deployment
# (see that repo's README.md, "Deployment" section).
MCP_ENDPOINT_URL=https://your-api-id.execute-api.us-east-1.amazonaws.com/mcp

# Same Postgres instance the Python MCP server (chaunceyplum/mcp) uses
# (shared/db.py there). This harness applies its own db/schema.sql
# (runs, tasks, task_runs) to this database — separate tables from that
# repo's Python orchestrator tables.
DATABASE_URL=postgresql://user:pass@rds-host/aecmcp?sslmode=require

# CX Agent Manager's own MCP endpoint ("Cookbook") — where the real Workfront
# connector (workflow_*/insights_*/comment-stream_* tools) actually lives.
# MCP_ENDPOINT_URL above is the separate 238-tool AEC server and has no
# Workfront tools at all — without this set, every Workfront call in
# lib/agents/intake/workfront.ts and lib/agents/review/workfront-notes.ts
# fails with "Unknown tool". Once set, mcp-client.ts routes every
# non-wf_/fusion_-prefixed tool call here instead.
# MCP_GATEWAY_HEADER names the auth header; MCP_GATEWAY_TOKEN is sent as its
# value verbatim (not Bearer-prefixed, since the header isn't
# "Authorization") — ask a teammate for the real x-cookbook-login value.
MCP_GATEWAY_URL=http://34.203.238.63:8080/mcp
MCP_GATEWAY_HEADER=x-cookbook-login
MCP_GATEWAY_TOKEN=id:password

# REQUIRED alongside MCP_GATEWAY_URL — this gateway namespaces every tool by
# source server (e.g. "workfront-adobe__insights_find_id_by_name"), so
# without this every call goes out under its bare name and 404s. See
# mcp-client.ts's applyGatewayPrefix. This list is a statement about what
# this app actually calls, not the gateway's full catalog — it grows every
# time a new tool family gets used (insights_/planning_ were missing at
# first, then destination_).
MCP_GATEWAY_ROUTES=adobe-aec:adobe_,search_,cja_,dataprep_,destination_,flow_,msb_,query_,reactor_,source_,execute_sql,knowledge_base_health;workfront-adobe:workflow_,comment-stream_,approvals_,insights_,planning_

# ─────────────────────────────────────────────────────────────────────────
# LLM extraction for Agent 1 (Intake) — OPTIONAL, opt-in.
#
# When LLM_PROVIDER is UNSET, Intake reads briefs with the deterministic
# regex parser exactly as before. Set it to turn on LLM-assisted extraction;
# the LLM only reads the brief into structured fields, which are then run
# through the same deterministic validation, and ANY failure (bad key, no
# host, timeout, malformed output) silently falls back to the regex parser.
# See src/lib/llm/ and src/lib/agents/intake/llm-extract.ts.
#
# Pick ONE provider:
# LLM_PROVIDER=bedrock | anthropic | ollama

# --- Provider: AWS Bedrock (Claude on Bedrock; SigV4-signed, no SDK) ---
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_SESSION_TOKEN=...            # only for temporary/STS credentials
# BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0   # optional

# --- Provider: Anthropic Claude API ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest   # optional
# ANTHROPIC_BASE_URL=https://api.anthropic.com   # optional (proxy/gateway)

# --- Provider: self-hosted Ollama (default port 11434) ---
# OLLAMA_HOST changes frequently, so it has NO default — set it every time.
# Accepts "10.0.0.5", "10.0.0.5:11434", or a full URL; scheme defaults to
# http and port to 11434 when omitted.
# OLLAMA_HOST=http://10.0.0.5:11434
# OLLAMA_MODEL=llama3.1

# ─────────────────────────────────────────────────────────────────────────
# Agent 3 segment creation — OPTIONAL, OFF by default.
#
# When an LLM is configured, Agent 3 drafts a PQL expression and verifies every
# field it references is actually present in AEP. By default that verified
# expression is only ATTACHED as a draft for a human to build from — nothing is
# written. Set this to true to let Agent 3 actually create the segment from a
# verified expression (the only write Agent 3 can do; off by default like
# activation). A run on a gateway without segment-write enabled reports an
# honest dry-run rather than a silent no-op.
# AUDIENCE_CREATE_SEGMENT=true

# ─────────────────────────────────────────────────────────────────────────
# Kill switch for ALL Workfront writes — OFF by default.
#
# The Workfront write tools (issue create, custom-field set, comment post) are
# unusable in some environments (they 404 / error at the gateway) and can block
# an end-to-end test run. Set this to true to skip every Workfront write cleanly
# (reported as skipped in the trace, not a failure) so the pipeline flow can be
# exercised without them. AEP reads / LLM / everything else are unaffected.
# WORKFRONT_WRITES_DISABLED=true

# ─────────────────────────────────────────────────────────────────────────
# Governance (src/lib/governance/, docs/governance/risk-register.md)
#
# Every LLM prompt has emails, phones, SSNs, card numbers and IPs swapped for
# placeholders before it leaves this app, and restored locally in the answer.
# On by default; "off" disables it (every call is still written to audit_events).
# LLM_PII_REDACTION=off
#
# Make POST /api/runs/[runId]/continue (the per-agent approval gate) require
# an "adminName" from ADMIN_NAMES. Off by default: the pipeline chat view has
# no admin picker yet, so approvals from there are audited as "unidentified".
# REQUIRE_NAMED_APPROVER=true
